# =============================================================================
# DATASCOUT — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local no repositório.
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE
# Encontre em: https://supabase.com/dashboard → seu projeto → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Usada apenas no servidor (nunca exposta ao browser)
# Encontre em: Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# -----------------------------------------------------------------------------
# STRIPE
# Encontre em: https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Chave pública — usada no frontend para inicializar o Stripe.js
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Webhook secret — gerado ao criar o endpoint em Stripe → Developers → Webhooks
# Em desenvolvimento use: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# IDs dos produtos/preços dos planos (Stripe → Products)
STRIPE_PRICE_ID_PRO=price_XXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_ID_BASIC=price_XXXXXXXXXXXXXXXXXXXXXXXXXX   # se houver plano básico


# -----------------------------------------------------------------------------
# NEXT-AUTH
# Encontre em: https://next-auth.js.org/configuration/options
# -----------------------------------------------------------------------------

# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# URL base da aplicação
# Desenvolvimento: http://localhost:3000
# Produção: https://seu-dominio.com.br
NEXTAUTH_URL=https://seu-dominio.com.br


# -----------------------------------------------------------------------------
# APP (geral)
# -----------------------------------------------------------------------------

# URL pública da aplicação (usada em emails, redirects, etc.)
NEXT_PUBLIC_APP_URL=https://seu-dominio.com.br

# Ambiente: development | production
NODE_ENV=production
